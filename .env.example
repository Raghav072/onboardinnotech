# Copy to .env.local (git-ignored) and fill in. Names only here: never commit real values.
# Supabase project URL and anon / publishable key (Project settings > API). Never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Your deployment origin (used in confirmation emails). Empty = Supabase dashboard "Site URL".
NEXT_PUBLIC_SITE_URL=
# Optional comma-separated allow-list, e.g. your university's email domain. Empty = anyone may sign up.
ALLOWED_EMAIL_DOMAINS=
