{
  "name": "onboard",
  "version": "0.1.0",
  "private": true,
  "description": "ONBOARD \u2014 Your All-in-Uni Companion. Milestone 4: secure student/alumni messaging with database-enforced eligibility on the Milestone 3 discovery and Milestone 2 Supabase foundation.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "check:static": "node scripts/check-static.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:db && npm run check:static",
    "test:db": "bash scripts/test-db.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0"
  }
}
